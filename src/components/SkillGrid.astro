---
import type { SkillCategory } from '../data/skills';

interface Props {
  categories: SkillCategory[];
}

const { categories } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    categories.map((cat) => (
      <div
        class="rounded-xl border p-5"
        style="border-color: var(--color-border); background-color: var(--color-bg-secondary);"
      >
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">
          {cat.name}
        </h3>
        <div class="flex flex-wrap gap-2">
          {cat.skills.map((skill) => (
            <span
              class="rounded-full px-2.5 py-1 text-sm font-medium"
              style="background-color: var(--color-bg-tertiary); color: var(--color-text-secondary); border: 1px solid var(--color-border);"
            >
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))
  }
</div>
