---
import BaseLayout from './BaseLayout.astro';
import SeriesNav from '../components/SeriesNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate } from '../utils/date-format';
import { getReadingTime } from '../utils/reading-time';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  category: string;
  tags: string[];
  body: string;
  series?: string;
  seriesOrder?: number;
  canonical?: string;
  headings?: { depth: number; slug: string; text: string }[];
  seriesData?: {
    name: string;
    total: number;
    prev?: { slug: string; title: string };
    next?: { slug: string; title: string };
  };
}

const {
  title,
  description,
  date,
  updated,
  category,
  tags,
  body,
  series,
  seriesOrder,
  canonical,
  headings = [],
  seriesData,
} = Astro.props;

const readingTime = getReadingTime(body);

const categoryLabels: Record<string, string> = {
  'stablecoin-payments': 'Stablecoin Payments',
  'system-design': 'System Design',
  'payments-engineering': 'Payments Engineering',
  'blockchain': 'Blockchain',
  'distributed-systems': 'Distributed Systems',
  'career': 'Career',
  'mpc-cryptography': 'MPC Cryptography',
  'java-engineering': 'Java Engineering',
  'architecture-decisions': 'Architecture Decisions',
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <!-- Reading progress bar -->
  <div
    id="progress-bar"
    class="fixed top-0 left-0 z-[100] h-0.5 transition-all duration-150"
    style="background: linear-gradient(90deg, var(--color-gradient-start), var(--color-gradient-end)); width: 0%;"
  >
  </div>

  <div class="mx-auto max-w-5xl px-6 py-16 xl:grid xl:grid-cols-[1fr_220px] xl:gap-10">
    <article>
      <header class="mb-10">
        {series && seriesOrder && (
          <p class="mb-3 text-sm font-medium" style="color: var(--color-accent); font-family: var(--font-mono);">
            {series} · Part {seriesOrder}
          </p>
        )}
        <h1
          class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl"
          style="color: var(--color-text-primary);"
        >
          {title}
        </h1>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <time datetime={date.toISOString()} class="text-sm" style="color: var(--color-text-muted); font-family: var(--font-mono);">
            {formatDate(date)}
          </time>
          <span style="color: var(--color-border);">·</span>
          <span class="text-sm" style="color: var(--color-text-muted);">
            {readingTime} min read
          </span>
          <span style="color: var(--color-border);">·</span>
          <span
            class="rounded-full px-2.5 py-0.5 text-xs font-medium"
            style="background-color: var(--color-bg-tertiary); color: var(--color-text-muted); border: 1px solid var(--color-border);"
          >
            {categoryLabels[category] || category}
          </span>
        </div>

        {updated && (
          <p class="mt-2 text-xs" style="color: var(--color-text-muted);">
            Updated {formatDate(updated)}
          </p>
        )}

        {tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={`/blog/tags/${tag}`}
                class="rounded-full px-2 py-0.5 text-xs font-medium transition-colors"
                style="background-color: var(--color-bg-tertiary); color: var(--color-text-muted); border: 1px solid var(--color-border);"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>

      <div class="prose prose-lg max-w-none" style="--tw-prose-body: var(--color-text-secondary); --tw-prose-headings: var(--color-text-primary);">
        <slot />
      </div>

      {seriesData && seriesOrder && (
        <SeriesNav
          seriesName={seriesData.name}
          currentOrder={seriesOrder}
          totalPosts={seriesData.total}
          prevPost={seriesData.prev}
          nextPost={seriesData.next}
        />
      )}

      <!-- Share -->
      <div class="mt-10 flex items-center gap-4 border-t pt-6" style="border-color: var(--color-border);">
        <span class="text-sm font-medium" style="color: var(--color-text-muted); font-family: var(--font-mono);">Share:</span>
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(`https://puneethkumarck.dev/blog/${Astro.params.slug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm transition-colors"
          style="color: var(--color-text-secondary);"
        >
          Twitter
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://puneethkumarck.dev/blog/${Astro.params.slug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm transition-colors"
          style="color: var(--color-text-secondary);"
        >
          LinkedIn
        </a>
        <button
          id="copy-link"
          class="text-sm transition-colors"
          style="color: var(--color-text-secondary);"
        >
          Copy Link
        </button>
      </div>
    </article>

    <TableOfContents headings={headings} />
  </div>

  <script>
    // Reading progress bar
    const progressBar = document.getElementById('progress-bar');
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      if (progressBar) {
        progressBar.style.width = `${Math.min(progress, 100)}%`;
      }
    });

    // Copy link
    document.getElementById('copy-link')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(window.location.href);
      const btn = document.getElementById('copy-link');
      if (btn) {
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'Copy Link'; }, 2000);
      }
    });
  </script>
</BaseLayout>
