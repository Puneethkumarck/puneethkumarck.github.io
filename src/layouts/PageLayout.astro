---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  subtitle?: string;
}

const { title, description, subtitle } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-4xl px-6 py-16">
    <header class="mb-12">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--color-text-primary);">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-3 text-lg" style="color: var(--color-text-secondary);">
          {subtitle}
        </p>
      )}
    </header>
    <slot />
  </div>
</BaseLayout>
